@host = http://localhost:5278
@adminToken = REEMPLAZAR_TOKEN_ADMIN
@patientToken = REEMPLAZAR_TOKEN_PACIENTE
@specialityId = 00000000-0000-0000-0000-000000000000
@doctorId = 00000000-0000-0000-0000-000000000000
@availabilityId = 00000000-0000-0000-0000-000000000000

### Login administrador
POST {{host}}/api/auth/admin/login
Content-Type: application/json
{
    "email": "admin@system.com",
    "password": "Admin123!"
}

### Login paciente 
POST {{host}}/api/auth/patient/login
Content-Type: application/json
{
    "email": "paciente@mail.com", 
    "dni": 12345678

}



### Health Check
GET {{Dsw2026Tpi.Api_HostAddress}}/health-check
Accept: application/json

### Crear especialidad
POST {{host}}/api/specialties Authorization: Bearer {{adminToken}} Content-Type: application/json 
{ 
  "name": "Cardiología",
  "description": "Atención y control cardiovascular"
}  

### Listar especialidades 

GET {{host}}/api/specialties?pageSize=10&pageIndex=0 
Authorization: Bearer {{adminToken}}

### Crear médico 
POST {{host}}/api/doctors
Authorization: Bearer {{adminToken}}
Content-Type: application/json
{
  "name": "Ana Pérez",
  "licenseNumber": "MP-12345", 
  "specialityId": "{{specialityId}}"
} 

### Crear disponibilidad mensual
POST {{host}}/api/availabilities
Authorization: Bearer {{adminToken}}
Content-Type: application/json
{
}
"doctorId": "{{doctorId}}",
"days": [
{
"day": "LUNES",
"startTime": "09:00",
"endTime": "12:00"
}
]
### Consultar slots libres
GET {{host}}/api/availabilities?doctorId={{doctorId}}
Authorization: Bearer {{patientToken}}
